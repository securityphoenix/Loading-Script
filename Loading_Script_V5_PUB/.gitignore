# Loading_Script_V5 — bundle .gitignore
# The repository root has one too. This file keeps the bundle self-contained,
# so it still works when the folder is copied out on its own.

# --- Secrets. Never commit. Copy the *.TEMPLATE file and fill it in. ---
config.ini
config_local*.ini
config_multi_scanner.ini
config_test*.ini
!config_multi_scanner.ini.TEMPLATE
!config_test_TEMPLATE.ini
.env
.env.*
!.env.example
!.env.database
*.pem
*.key
credentials.json
token.json

# --- Runtime output ---
logs/
errors/
debug/
tests_logs/
uploads/
*.log

# --- Job and result data ---
*.db
*.sqlite
*.sqlite3
test_results*.json
test_results*.csv

# --- Python ---
__pycache__/
*.py[cod]
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# --- Virtual environments ---
.venv/
venv/
env/

# --- OS and editor noise ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# --- Scan input you drop in to try the tool ---
scans/
scan_files/
